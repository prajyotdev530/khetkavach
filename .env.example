# KhetKavach environment variables. Copy to `.env` and fill in. Never commit `.env`, and never put real keys here.

# --- Backend ---
# Gemini API key from Google AI Studio (free tier) - runs the agent's plan/recover/write steps.
GEMINI_API_KEY=
# Free-tier Gemini model with function calling + JSON output (verified in backend/scripts/spike_gemini.py).
GEMINI_MODEL=gemini-3.5-flash-lite
# Sarvam AI key - translation (sarvam-translate:v1), voice (bulbul:v4-flash), speech-to-text (saaras:v4).
SARVAM_API_KEY=
# Supabase project URL and service-role key (backend only) - response cache, share links, audio cache.
SUPABASE_URL=
SUPABASE_KEY=
# Required by the Nominatim usage policy: identify the app and give a real contact email.
NOMINATIM_USER_AGENT=KhetKavach/1.0 (contact: your-team-email@example.com)
# Comma-separated list of frontend origins allowed by CORS (your Vercel URL in production).
ALLOWED_ORIGINS=http://localhost:5174
# true enables the `fail=` demo parameter that simulates a source outage (section 11).
DEMO_CONTROLS=true
# (P1, F14) data.gov.in API key for district crop-yield statistics.
DATA_GOV_IN_API_KEY=

# --- Frontend (set in Vercel at build time) ---
VITE_API_URL=http://localhost:7861
